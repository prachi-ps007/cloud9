# Copy this file to .env and edit the values
PORT=4000
HOST=0.0.0.0

# Where the SQLite database file lives
DB_PATH=./data/cloud9.db

# Where uploaded files are stored (can be on a bigger drive, e.g. D:/cloud9-storage)
STORAGE_DIR=./storage

# Initial storage allocation in GB (the owner can change it later in the app)
DEFAULT_STORAGE_LIMIT_GB=10

# Login session lifetime in days
SESSION_DAYS=30

# The first account becomes the owner. Set true to let more people sign up.
ALLOW_REGISTRATION=false

# Allowed browser origins for CORS ("*" = any)
CORS_ORIGIN=*

# URL a phone opens after scanning the QR code. Leave empty unless you need to override it.
PUBLIC_URL=

# Built React app to serve in production
CLIENT_DIST=../client/dist

# Optional: demo account for free hosts with an ephemeral disk
# DEMO_SEED=true
# DEMO_USERNAME=demo
# DEMO_PASSWORD=choose-a-throwaway-password